{
  "name": "extropian-web-ui",
  "version": "0.1.0",
  "description": "Declarative 2D builder UI — one JSON spec, render to DOM with KaTeX + d3",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "d3-axis": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "katex": "^0.16.0"
  },
  "devDependencies": {
    "@types/d3-axis": "^3.0.0",
    "@types/d3-force": "^3.0.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.0",
    "@types/d3-selection": "^3.0.0",
    "@types/d3-shape": "^3.0.0",
    "@types/d3-zoom": "^3.0.0",
    "@types/katex": "^0.16.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
